# ── Execution mode ────────────────────────────────────────────────────────────
EXECUTION_MODE=SHADOW

# ── PostgreSQL (system of record) ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ssip:ssip@localhost:5432/ssip

# ── SQL Server (read-only student data) ───────────────────────────────────────
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASS=
MSSQL_DATABASE=

# ── GHL (GoHighLevel) ─────────────────────────────────────────────────────────
GHL_API_KEY=
GHL_BASE_URL=https://rest.gohighlevel.com
GHL_LOCATION_ID=

# ── Synthflow (call provider) ─────────────────────────────────────────────────
SYNTHFLOW_API_KEY=
SYNTHFLOW_PHONE_NUMBER=

# ── LLM (transcript analysis) ─────────────────────────────────────────────────
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_HOUR=18
SCHEDULER_MINUTE=0
SCHEDULER_TIMEZONE=America/Chicago
