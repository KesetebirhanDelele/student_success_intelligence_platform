# System scope: MVP | STANDARD | PRODUCTION
SYSTEM_SCOPE=MVP

# Database (SQLite for MVP, swap to SQL Server for production)
DATABASE_URL=sqlite:///./ssip.db

# GHL Integration
GHL_API_URL=https://rest.gohighlevel.com/v1
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_location_id_here
GHL_MOCK_MODE=true

# Scheduler (daily run at 6 PM CST)
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=18
SCHEDULER_MINUTE=0
SCHEDULER_TIMEZONE=America/Chicago

# API security (leave empty to disable for MVP local dev)
API_TOKEN=
